# Copy to .env and fill in. `.env` is gitignored at any depth and is stripped when a
# package is published — credentials belong to the environment an agent runs in, not to
# the artifact. A package declares only the *names* it needs, via `environment.required`
# in its agent.yaml.
#
# Already-exported variables win over this file, so a container that exports a key and
# also mounts a stale .env gets the exported one.

# The provider your agent's model needs. Only the one you actually call.
OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GOOGLE_API_KEY=

# Optional: where the hub lives. Wins over `hub.path` in ~/.config/teacup/config.yaml.
# TEACUP_HOME=~/.teacup/agents

# Optional: an explicit settings file (never secrets — see docs/execution.md §4).
# TEACUP_CONFIG=~/.config/teacup/config.yaml
